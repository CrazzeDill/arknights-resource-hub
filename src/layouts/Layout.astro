---
// Layout for all pages
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ImageModal from '../components/ImageModal.astro';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Arknights Resource Hub</title>
    <link rel="icon" type="image/svg+xml" href="/arknights-logo.svg" />
    <link rel="stylesheet" href="/styles/global.css" />
    <meta name="description" content="Comprehensive resource hub for Arknights players" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <ImageModal />
    <script>
      // Scrollspy: highlight sidebar links based on visible sections
      (function(){
        if (!('IntersectionObserver' in window)) return;
        const links = Array.from(document.querySelectorAll('.sidebar-nav a'));
        // Only consider anchors that link to page fragments (start with '#')
        const sections = links
          .map(a => {
            const href = a.getAttribute('href') || '';
            if (!href.startsWith('#')) return null;
            try {
              return document.querySelector(href);
            } catch (e) {
              return null;
            }
          })
          .filter(Boolean);

        if (sections.length === 0) return;

        const clearActive = () => links.forEach(l => l.classList.remove('active'));

        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            const id = entry.target.id;
            const link = document.querySelector('.sidebar-nav a[href="#' + id + '"]') as HTMLAnchorElement | null;
            if (!link) return;
            if (entry.isIntersecting) {
              clearActive();
              link.classList.add('active');
              // If the link has a data-parent, also activate the parent group link
              // const parentId = link.dataset.parent;
              // if (parentId) {
              //   // parent links in our markup are not anchors; try to find a matching child anchor with that parent id
              //   const parentAnchor = document.querySelector('.sidebar-nav a[data-parent="' + parentId + '"]') as HTMLAnchorElement | null;
              //   if (parentAnchor) parentAnchor.classList.add('active');
              // }
            }
          });
        }, { root: null, rootMargin: '0px 0px -60% 0px', threshold: 0 });

        sections.forEach(s => observer.observe(s as Element));
      })();
    </script>
  </body>
</html>