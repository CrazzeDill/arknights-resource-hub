---
import Layout from '../layouts/Layout.astro';
import CategorySection from '../components/CategorySection.astro';
import ResourceCard from '../components/ResourceCard.astro';

const workers = [
  {
    title: "Base Teams and Combos Guide",
    description: "Comprehensive guide by phlegyas#7344 and blackgatoacer covering base teams and combos",
    url: "https://docs.google.com/spreadsheets/d/1zYc2JU46X0XWmV7s1503bN4feRdOMa1eehrTQ2jGaiE/edit?usp=sharing",
    category: "Workers"
  },
  {
    title: "Base Combo cheat sheet",
    description: "Quick reference guide by Shlhu#4805 for base worker combos",
    url: "https://docs.google.com/spreadsheets/d/1unxiDfT8kvJzwDf-xqCb1wPohkVPsX4-cgl37_6cRjQ/edit#gid=1374380275",
    category: "Workers"
  },
  {
    title: "Good Low Rarity Investment Guide",
    description: "Guide by Forge, Neia#6681 and others on valuable low-rarity operators for base investment",
    url: "https://docs.google.com/spreadsheets/d/1MAvUMeuC0BkF5Hu1s3xM7Zmn2HahZZlinchSHnKqjXk/edit#gid=75208859",
    category: "Workers"
  }
];

const layoutEfficiency = [
  {
    title: "80 Second Economics - Base-Related Video Guides",
    description: "Video guides by cube#1588 covering base layout efficiency (last updated August 23, 2020)",
    url: "https://www.youtube.com/watch?v=eolMMsRn794",
    category: "Layout & Efficiency"
  },
  {
    title: "Orundum Farming Guide",
    description: "Guide by Malicast#8591 on efficient orundum farming while maintaining game progress",
    url: "https://docs.google.com/document/d/1mXML196voUUGswEyn3D-NCALqOEpvajWKiYZXBiYmJ4/edit",
    category: "Layout & Efficiency"
  },
  {
    title: "Base Facilities and Mechanics Info",
    description: "Information on base facilities mechanics by cube#1588 (no update since August 23, 2020)",
    url: "https://drive.google.com/file/d/1_otUfbyVHmGtYItmHqLgMXuhlDpM9dKG/view?usp=sharing",
    category: "Layout & Efficiency"
  }
];

const infographics = [
  {
    title: "Shlhu's Base Combos",
    description: "Infographic showing effective base worker combos",
    url: "https://i.imgur.com/xbM3thT.png",
    category: "Infographics",
    isImage: true
  },
  {
    title: "Low Rarity Base Investment Guide",
    description: "Infographic showing valuable low-rarity operators for base investment",
    url: "https://i.imgur.com/28T70G8.png",
    category: "Infographics",
    isImage: true
  }
];
---

<Layout title="Base Resources - Arknights Resource Hub">
  <h1>Base-Related Resources</h1>
  <p class="page-description">Resources for optimizing your Rhodes Island base operations</p>

  <CategorySection id="workers" title="Workers" description="Guides and resources for effective worker team compositions">
    {workers.map(resource => (
      <ResourceCard 
        title={resource.title}
        description={resource.description}
        url={resource.url}
        category={resource.category}
      />
    ))}
  </CategorySection>

  <CategorySection id="layout-efficiency" title="Layout and Efficiency" description="Resources for base layout planning and resource efficiency">
    {layoutEfficiency.map(resource => (
      <ResourceCard 
        title={resource.title}
        description={resource.description}
        url={resource.url}
        category={resource.category}
      />
    ))}
  </CategorySection>

  <CategorySection id="infographics" title="Infographics" description="Visual guides for quick reference">
    {infographics.map(resource => (
      <ResourceCard 
        title={resource.title}
        description={resource.description}
        url={resource.url}
        category={resource.category}
        isImage={resource.isImage}
      />
    ))}
  </CategorySection>
</Layout>