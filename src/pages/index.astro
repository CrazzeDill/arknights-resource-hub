const skins = [
  { title: "Future Skins Overview", description: "Predicted upcoming skins by shirra and others", link: "https://docs.google.com/spreadsheets/d/1UIZNZxVPeTOHkNmVUciSXLz3dlLr4u5309e-I4En_-4/edit#gid=0", isImage: false, categoryIcon: 'database' as CategoryIcon },
