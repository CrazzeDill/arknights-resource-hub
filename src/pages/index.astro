    categoryIcon: 'guide' as CategoryIcon
  },
  {
    title: "Base Combo cheat sheet",
    description: "Quick reference guide by Shlhu#4805 for base worker combos",
    link: "https://docs.google.com/spreadsheets/d/1unxiDfT8kvJzwDf-xqCb1wPohkVPsX4-cgl37_6cRjQ/edit#gid=1374380275",
    categoryIcon: 'guide' as CategoryIcon
  },
  {
    title: "Good Low Rarity Investment Guide",
    description: "Guide by Forge, Neia#6681 and others on valuable low-rarity operators for base investment",
    link: "https://docs.google.com/spreadsheets/d/1MAvUMeuC0BkF5Hu1s3xM7Zmn2HahZZlinchSHnKqjXk/edit#gid=75208859",
    categoryIcon: 'guide' as CategoryIcon
  }
];

const layoutEfficiency = [
  {
    title: "80 Second Economics - Base-Related Video Guides",
    description: "Video guides by cube#1588 covering base layout efficiency (last updated August 23, 2020)",
    link: "https://www.youtube.com/watch?v=eolMMsRn794",
    isYouTube: true,
    categoryIcon: 'guide' as CategoryIcon
  },
  {
    title: "Orundum Farming Guide",
    description: "Guide by Malicast#8591 on efficient orundum farming while maintaining game progress",
    link: "https://docs.google.com/document/d/1mXML196voUUGswEyn3D-NCALqOEpvajWKiYZXBiYmJ4/edit",
    categoryIcon: 'guide' as CategoryIcon
  },
  {
    title: "Base Facilities and Mechanics Info",
    description: "Information on base facilities mechanics by cube#1588 (no update since August 23, 2020)",
    link: "https://drive.google.com/file/d/1_otUfbyVHmGtYItmHqLgMXuhlDpM9dKG/view?usp=sharing",
    categoryIcon: 'reference' as CategoryIcon
