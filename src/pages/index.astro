  { title: "Krooster - Roster sharing tool", description: "Roster management and planning tool", link: "https://www.krooster.com/", categoryIcon: 'planning' as CategoryIcon },
  { title: "Penguin Stats - Drop rates and planner", description: "Drop rate statistics and material planning", link: "https://penguin-stats.io/", categoryIcon: 'planning' as CategoryIcon },
  { title: "Arknights Wiki", description: "Comprehensive wiki covering stages, lore, events, mechanics and operators", link: "https://arknights.wiki.gg/wiki/Arknights_Terra_Wiki", categoryIcon: 'wiki' as CategoryIcon },
  { title: "Module Overview", description: "Complete information on module effects, release information, and unlock conditions", link: "https://docs.google.com/spreadsheets/d/e/2PACX-1vTA6I0ffKjIubfoxd3GedgVScdQ2G90EFSlHzADsNP7nk5nXa8BNyW3beeUS8WD6UXRu8EfV3bBSoRI/pubhtml", categoryIcon: 'database' as CategoryIcon }
];

// ============================================
// NEW CONTENT - Information Sheets (from Discord)
// ============================================
const informationSheets = [
  {
    title: "Roadless Camelot - Arknights Info",
    description: "Includes: Reroll and Beginner Guides, Mastery and Module Recs, Upcoming Banner Priority, Banner Pity Guide, Top Operator Selection, Limited Banner Off-Rates, Annihilation Overview",
    link: "https://docs.google.com/spreadsheets/d/1-EUreXBiEGVo8boM16dqj24-bHclkneGUja-VIvInig/",
    credit: "Discord User",
    categoryIcon: 'guide' as CategoryIcon
  },
  {
    title: "Starter Squad Building",
    description: "Visual guide for building effective starter squads",
    link: "https://i.imgur.com/RnF86SW.png",
    isImage: true,
    categoryIcon: 'guide' as CategoryIcon
  },
  {
    title: "Module Ratings",
    description: "Comprehensive module ratings and recommendations",
    link: "https://docs.google.com/spreadsheets/d/1A0_0XTAcDDtHkvyAwjTqEEzM8cf5h3E60u23ZVXw4eg/",
    credit: "Discord User",
    categoryIcon: 'database' as CategoryIcon
  },
  {
    title: "Paid Pack Comparison",
    description: "Comparison guide for paid packs and their value",
    link: "https://docs.google.com/spreadsheets/d/1wyOjP0fvK5My9CAHtrJZKdJ2MJbMzBM6sjYIhjS8TGo/",
    credit: "Discord User",
    categoryIcon: 'calculator' as CategoryIcon
  },
  {
    title: "Mechanics List",
    description: "Comprehensive list of game mechanics",
    link: "https://docs.google.com/spreadsheets/d/11Stfk6ymNVBrFQMS5_3gDkKQYC1f4QOouA7ObMx4MJg/",
    credit: "Discord User",
    categoryIcon: 'reference' as CategoryIcon
  }
];

// ============================================
// NEW CONTENT - Various Tools (from Discord)
// ============================================
const variousTools = [
  {
    title: "Arknights Terra Wiki",
    description: "Community-maintained wiki with comprehensive game information",
    link: "https://arknights.wiki.gg/wiki/Arknights_Terra_Wiki",
    categoryIcon: 'wiki' as CategoryIcon
  },
  {
    title: "PRTS Wiki",
    description: "Chinese wiki with detailed operator and stage information",
    link: "https://prts.wiki/w/%E9%A6%96%E9%A1%B5",
    categoryIcon: 'wiki' as CategoryIcon
  },
  {
    title: "Tomimi.dev Wiki",
    description: "Alternative wiki with clean interface",
    link: "https://tomimi.dev/en",
    categoryIcon: 'wiki' as CategoryIcon
  },
  {
    title: "Krooster - Roster Tracking",
    description: "Track and plan your operator roster",
    link: "https://www.krooster.com/",
    categoryIcon: 'planning' as CategoryIcon
  },
  {
    title: "Puppiiz (Aceship fork)",
    description: "Unit databases, calculators and planner tools",
    link: "https://puppiizsunniiz.github.io/AN-EN-Tags/index.html",
    categoryIcon: 'database' as CategoryIcon
  },
  {
    title: "Hermitz Skin Planner",
    description: "Plan and preview operator skins",
    link: "https://hermitzplanner.github.io/skins/",
    categoryIcon: 'planning' as CategoryIcon
  },
  {
    title: "map.ARK",
    description: "Interactive stage maps and guides",
    link: "https://map.ark-nights.com/",
    categoryIcon: 'maps' as CategoryIcon
  },
  {
    title: "Sanity;Gone Operator List",
    description: "Comprehensive operator database and information",
    link: "https://sanitygone.help/en/operators/",
    categoryIcon: 'database' as CategoryIcon
  },
  {
    title: "Penguin-stats Mat Drops",
    description: "Material drop rate statistics and farming planner",
    link: "https://penguin-stats.io/",
    categoryIcon: 'planning' as CategoryIcon
  },
  {
    title: "Pull Probability Calc",
    description: "Calculate gacha pull probabilities",
    link: "https://samidare.io/arknights/gacha",
    categoryIcon: 'calculator' as CategoryIcon
  },
  {
    title: "Trust Chart",
    description: "Visual trust farming chart",
    link: "https://i.imgur.com/eybSWuR.png",
    isImage: true,
    categoryIcon: 'reference' as CategoryIcon
  },
  {
    title: "Pull Income Calc",
    description: "Calculate expected pull income over time",
    link: "https://docs.google.com/spreadsheets/d/1TL3VjhiZ4QL2qwXt0XY1HdYIjT2-dAUHihxbXCIrgm8/",
    categoryIcon: 'calculator' as CategoryIcon
  }
];

const lastUpdated = "February 19, 2026";
---

<Layout title="Arknights Resource Hub">
  <div class="page-intro">
    <h1>Arknights Resource Hub</h1>
    <p class="lead">A community-maintained collection of resources for Arknights players</p>
    <p>Last updated: <time datetime={lastUpdated}>{lastUpdated}</time></p>
  </div>
  
  <!-- Hero banner with Arknights-themed design -->
  <section class="hero-banner">
    <div class="hero-content">
      <h2>Optimize Your Arknights Experience</h2>
      <p>Discover comprehensive guides, tools, and resources to enhance your gameplay</p>
    </div>
  </section>
  
  <div class="page-layout">
    <aside class="sidebar">
      <nav class="sidebar-nav">
        <h4>Quick Navigation</h4>
        <ul>
          <li class="nav-group">
            <strong>Base</strong>
            <ul>
              <li><a href="#workers" data-parent="base">Workers</a></li>
              <li><a href="#layout-efficiency" data-parent="base">Layout & Efficiency</a></li>
              <li><a href="#infographics" data-parent="base">Infographics</a></li>
            </ul>
          </li>
          <li class="nav-group">
            <strong>Future</strong>
            <ul>
              <li><a href="#banners" data-parent="future">Banners & Sheets</a></li>
              <li><a href="#events" data-parent="future">Events</a></li>
              <li><a href="#skins" data-parent="future">Skins</a></li>
              <li><a href="#farming" data-parent="future">Farming</a></li>
              <li><a href="#modules" data-parent="future">Modules</a></li>
            </ul>
          </li>
          <li class="nav-group">
            <strong>Efficiency</strong>
            <ul>
              <li><a href="#info-sheets" data-parent="efficiency">Info Sheets</a></li>
              <li><a href="#infographics-eff" data-parent="efficiency">Infographics</a></li>
            </ul>
          </li>
          <li class="nav-group">
            <strong>Utilities</strong>
            <ul>
              <li><a href="#planning-tools" data-parent="utilities">Planning Tools</a></li>
              <li><a href="#wiki-resources" data-parent="utilities">Wiki</a></li>
            </ul>
          </li>
          <li class="nav-group">
            <strong>Resources</strong>
            <ul>
              <li><a href="#information-sheets" data-parent="resources">Information Sheets</a></li>
              <li><a href="#various-tools" data-parent="resources">Various Tools</a></li>
            </ul>
          </li>
        </ul>
      </nav>
    </aside>

    <div class="content-main">
      {(() => {
        const baseSubsections = [
          { id: 'workers', title: 'Workers', description: 'Guides and resources for effective worker team compositions', items: workers },
          { id: 'layout-efficiency', title: 'Layout and Efficiency', description: 'Resources for base layout planning and resource efficiency', items: layoutEfficiency },
          { id: 'infographics', title: 'Infographics', description: 'Visual guides for quick reference', items: baseInfographics }
        ];

        const futureSubsections = [
          { id: 'banners', title: 'Informational Sheets and Guides', description: 'Predicted upcoming banners and operator releases', items: banners },
          { id: 'events', title: 'Upcoming Events', description: 'Events coming to the Global server based on CN releases', items: upcomingEvents.map(e => ({ title: `CN Event: ${e.cnDate}`, description: e.description, link: e.globalDate ? undefined : undefined })) },
          { id: 'skins', title: 'Skins Information', description: 'Predicted upcoming operator skins', items: skins },
          { id: 'farming', title: 'Farming Information', description: 'Predicted farming stages for upcoming events', items: farmingFuture },
          { id: 'modules', title: 'Module Information', description: 'Information about upcoming operator modules', items: modules }
        ];

        const efficiencySubsections = [
          { id: 'info-sheets', title: 'Info Sheets and Resources', description: 'Farming and resource maths sheets', items: infoSheets },
          { id: 'infographics-eff', title: 'Infographics', description: 'Visual efficiency guides', items: efficiencyInfographics }
        ];

        const utilitiesSubsections = [
          { id: 'planning-tools', title: 'Planning & Database Tools', items: utilities.filter(u => u.categoryIcon === 'planning' || u.categoryIcon === 'database') },
          { id: 'wiki-resources', title: 'Wiki Resources', items: utilities.filter(u => u.categoryIcon === 'wiki') }
        ];

        // NEW: Information Sheets subsections
        const informationSheetsSubsections = [
          { id: 'info-sheets-new', title: 'Community Guides & Sheets', description: 'Information sheets and guides from the community', items: informationSheets }
        ];

        // NEW: Various Tools subsections
        const variousToolsSubsections = [
          { id: 'tools-wiki', title: 'Wiki Resources', description: 'Community wikis and databases', items: variousTools.filter(t => t.categoryIcon === 'wiki') },
          { id: 'tools-planning', title: 'Planning & Tracking', description: 'Tools for roster management and planning', items: variousTools.filter(t => t.categoryIcon === 'planning') },
          { id: 'tools-database', title: 'Databases', description: 'Operator and game databases', items: variousTools.filter(t => t.categoryIcon === 'database') },
          { id: 'tools-calculators', title: 'Calculators', description: 'Gacha and resource calculators', items: variousTools.filter(t => t.categoryIcon === 'calculator') },
          { id: 'tools-maps', title: 'Maps & Reference', description: 'Stage maps and reference materials', items: variousTools.filter(t => t.categoryIcon === 'maps' || t.categoryIcon === 'reference') }
        ];

        return (
          <>
            <GroupedSection id="base" title="Base Resources" description="Base-related subsections" subsections={baseSubsections} icon="base" />
            <GroupedSection id="future" title="Future Content" description="Predictions and info about upcoming content" subsections={futureSubsections} icon="future" />
            <GroupedSection id="efficiency" title="Efficiency & Optimization" description="Resources for maximizing your resource gathering and progression" subsections={efficiencySubsections} icon="efficiency" />
            <GroupedSection id="utilities" title="Various Utilities" description="Essential tools and resources for Arknights players" subsections={utilitiesSubsections} icon="utilities" />
            <GroupedSection id="information-sheets" title="Information Sheets" description="Community-maintained guides and information sheets" subsections={informationSheetsSubsections} icon="resources" />
            <GroupedSection id="various-tools" title="Various Tools" description="External tools and resources for Arknights players" subsections={variousToolsSubsections} icon="resources" />
          </>
        );
      })()}
    </div>
  </div>
</Layout>
