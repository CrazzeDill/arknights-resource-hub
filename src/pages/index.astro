const upcomingEvents = [
  { cnDate: "March 7, 2025 – March 21, 2025", description: "Upcoming event scheduled for March 2025 in CN server" },
  { cnDate: "March 20, 2025 – April 10, 2025", description: "Upcoming event scheduled for late March 2025 in CN server" },
  { cnDate: "April 7, 2025 – April 21, 2025", description: "Upcoming event scheduled for early April 2025 in CN server" },
  { cnDate: "May 1, 2025 – May 22, 2025", description: "Arknights CN's 6th Anniversary event", globalDate: "Mid/late October 2025 (as the 2025 2nd Celebration event)" },
  { cnDate: "August 2, 2025 – August 23, 2025", description: "Summer 2025 event", globalDate: "Around January 16, 2026 (as Arknights Global's 6th Anniversary event)" }
