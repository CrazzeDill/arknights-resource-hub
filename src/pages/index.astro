---
import Layout from '../layouts/Layout.astro';
import GroupedSection from '../components/GroupedSection.astro';

// Type imports for categoryIcon
type CategoryIcon = 'wiki' | 'planning' | 'database' | 'calculator' | 'maps' | 'reference' | 'guide' | 'default';

// ============================================
// EXISTING CONTENT - Base Resources
// ============================================
const workers = [
  {
    title: "Base Teams and Combos Guide",
