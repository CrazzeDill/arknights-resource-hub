];

const baseInfographics = [
  {
    title: "Shlhu's Base Combos",
    description: "Infographic showing effective base worker combos",
    link: "https://i.imgur.com/xbM3thT.png",
    isImage: true,
    categoryIcon: 'reference' as CategoryIcon
  },
  {
    title: "Low Rarity Base Investment Guide",
    description: "Infographic showing valuable low-rarity operators for base investment",
    link: "https://i.imgur.com/28T70G8.png",
    isImage: true,
    categoryIcon: 'reference' as CategoryIcon
  }
];

// ============================================
// EXISTING CONTENT - Future Content
// ============================================
const banners = [
  {
    title: "Future Banner Reference",
    description: "Upcoming operator banners from CN server",
    link: "https://arknights.wiki.gg/wiki/Headhunting/Banners/Upcoming",
    categoryIcon: 'database' as CategoryIcon
  },
  {
    title: "Future Skins Sheet",
    description: "Predicted upcoming skins by crowd-sourced sheets",
    link: "https://docs.google.com/spreadsheets/d/1UIZNZxVPeTOHkNmVUciSXLz3dlLr4u5309e-I4En_-4/edit#gid=0",
    categoryIcon: 'database' as CategoryIcon
