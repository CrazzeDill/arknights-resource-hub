// ============================================
// EXISTING CONTENT - Efficiency
// ============================================
const infoSheets = [
  { title: "Arknights Farming Sheet (Moe's Sheet)", description: "Comprehensive farming guide maintained by PeterYR", link: "https://docs.google.com/spreadsheets/d/1RRiTIYVUNUf-xW8ljAJdYEOuSo23lpjHkPa0-zuC_4k/htmlview", categoryIcon: 'planning' as CategoryIcon },
  { title: "Resource Maths", description: "Calculations by community contributors", link: "https://docs.google.com/spreadsheets/d/1xXm-FGi63jJdxVYzwiYKwjcN8q0X7ZgKeHhgaoyklmI/preview#gid=139756758", categoryIcon: 'calculator' as CategoryIcon }
];

const efficiencyInfographics = [
  { title: "Recommended Farming Stages", description: "Visual guide showing optimal farming stages", link: "https://i.imgur.com/fZvFuFK.png", isImage: true, categoryIcon: 'reference' as CategoryIcon },
  { title: "Free Enhancement Packs Info", description: "Information on free enhancement packs availability", link: "https://i.imgur.com/pD50BHs.png", isImage: true, categoryIcon: 'reference' as CategoryIcon }
