---
// Resource card component
export interface Props {
  title: string;
  description: string;
  url: string;
  category?: string;
  isImage?: boolean;
}

const { title, description, url, category, isImage = false } = Astro.props;
---

<div class="resource-card">
  <div class="resource-card-header">
    {category && <span class="resource-category">{category}</span>}
    <h3>{title}</h3>
  </div>
  <div class="resource-card-body">
    <img src="/src/assets/thumbnail-placeholder.svg" alt="Thumbnail preview" style="width: 100%; height: auto; border-radius: 4px; margin-bottom: 0.75rem;">
    <p>{description}</p>
  </div>
  <div class="resource-card-footer">
    <a href={url} class={`resource-link ${isImage ? 'image-link' : ''}`} target="_blank" rel="noopener noreferrer">
      {isImage ? 'View Image' : 'Visit Resource'}
    </a>
  </div>
</div>