---
// GroupedSection: renders a top-level CategorySection containing multiple subsection CategorySections
import CategorySection from './CategorySection.astro';

export interface SubItem {
  title: string;
  description?: string;
  link?: string;
  isImage?: boolean;
  isYouTube?: boolean;
  credit?: string;
  categoryIcon?: 'wiki' | 'planning' | 'database' | 'calculator' | 'maps' | 'reference' | 'guide' | 'default';
}

// Extract YouTube video ID from various YouTube URL formats
function getYouTubeVideoId(url: string): string | null {
  if (!url) return null;
  try {
    const u = new URL(url);
    if (u.hostname.includes('youtube.com') && u.searchParams.has('v')) {
      return u.searchParams.get('v');
    }
    if (u.hostname === 'youtu.be') {
      return u.pathname.slice(1).split('/')[0];
    }
    if (u.hostname.includes('youtube.com') && u.pathname.startsWith('/embed/')) {
      return u.pathname.split('/embed/')[1]?.split('/')[0];
    }
  } catch {
    return null;
  }
  return null;
}

// Category icon SVGs
const categoryIcons: Record<string, string> = {
  wiki: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>`,
  planning: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>`,
  database: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>`,
  calculator: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line><line x1="16" y1="14" x2="16" y2="18"></line></svg>`,
  maps: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>`,
  reference: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>`,
  guide: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>`,
  default: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>`
};

export interface SubSection {
  id: string;
  title: string;
  description?: string;
  items: SubItem[];
}

export interface Props {
  id: string;
  title: string;
  description?: string;
  subsections: SubSection[];
  open?: boolean;
  icon?: 'base' | 'future' | 'efficiency' | 'utilities' | 'resources' | 'default';
}

const { id, title, description, subsections = [], open = false, icon = 'default' } = Astro.props;

function getButtonLabel(link?: string) {
  if (!link) return 'Open resource';
  const l = link.toLowerCase();
  if (l.includes('docs.google.com') && l.includes('spreadsheets')) return 'Open Spreadsheet';
  if (l.includes('docs.google.com') && l.includes('document')) return 'Open Document';
  if (l.includes('imgur.com')) return 'View Image';
  if (l.includes('youtube.com') || l.includes('youtu.be')) return 'Watch Video';
  return 'Open Resource';
}

function getButtonType(link?: string): 'spreadsheet' | 'document' | 'default' {
  if (!link) return 'default';
  const l = link.toLowerCase();
  if (l.includes('docs.google.com') && l.includes('spreadsheets')) return 'spreadsheet';
  if (l.includes('docs.google.com') && l.includes('document')) return 'document';
  return 'default';
}
---

<CategorySection id={id} title={title} description={description} collapsible open={open} icon={icon}>
  {subsections.map(section => (
    <CategorySection id={section.id} title={section.title} description={section.description} collapsible>
      <div class="simple-list">
        {section.items.map(item => {
          const youtubeId = item.isYouTube ? getYouTubeVideoId(item.link || '') : null;
          const iconSvg = categoryIcons[item.categoryIcon || 'default'] || categoryIcons.default;
          const buttonType = getButtonType(item.link);
          return (
          <article class="simple-resource">
            <h3 class="simple-title">
              {item.link ? (
                <a href={item.link} target="_blank" rel="noopener noreferrer" class="simple-link">
                  {item.title}
                </a>
              ) : (
                item.title
              )}
            </h3>
            {item.description && <p class="simple-desc">{item.description}</p>}
            {item.credit && <p class="simple-credit">Credit: {item.credit}</p>}
            {item.isImage ? (
              <div class="image-container">
                <a href={item.link} class="image-link" target="_blank" rel="noopener noreferrer">
                  <img src={item.link} alt={item.title} loading="lazy" />
                </a>
              </div>
            ) : item.isYouTube && youtubeId ? (
              <div class="youtube-embed">
                <iframe
                  src={`https://www.youtube.com/embed/${youtubeId}`}
                  title={item.title}
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                ></iframe>
              </div>
            ) : (
              item.link && (
                <p class="simple-footer">
                  <a href={item.link} class={`resource-button button-${buttonType}`} target="_blank" rel="noopener noreferrer">
                    <span class="button-icon" set:html={iconSvg} />
                    {getButtonLabel(item.link)}
                  </a>
                </p>
              )
            )}
          </article>
          );
        })}
      </div>
    </CategorySection>
  ))}
</CategorySection>

<style>
  .simple-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  
  .simple-link:hover {
    color: var(--accent-light);
  }
  
  .simple-credit {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0.25rem 0 0.5rem 0;
    font-style: italic;
  }
  
  .resource-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--gradient-accent);
    color: white;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all var(--transition-normal);
    border: none;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
  }
  
  .resource-button:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow);
  }
  
  .resource-button::after {
    content: "→";
    transition: transform var(--transition-fast);
  }
  
  .resource-button:hover::after {
    transform: translateX(4px);
  }
  
  /* Spreadsheet button - Excel-like green */
  .button-spreadsheet {
    background: var(--gradient-spreadsheet);
  }
  
  .button-spreadsheet:hover {
    box-shadow: var(--shadow-spreadsheet);
  }
  
  /* Document button - Word-like blue */
  .button-document {
    background: var(--gradient-docs);
  }
  
  .button-document:hover {
    box-shadow: var(--shadow-docs);
  }
  
  .button-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  .button-icon :global(svg) {
    width: 14px;
    height: 14px;
  }
  
  /* Image container styling to match existing behavior */
  .image-container {
    margin-top: 0.75rem;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-color);
    transition: all var(--transition-normal);
  }
  
  .image-container:hover {
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-glow);
  }
  
  .image-link {
    display: block;
    line-height: 0;
  }
  
  .image-link img {
    width: 100%;
    height: auto;
    display: block;
    cursor: pointer;
    transition: transform var(--transition-normal);
  }
  
  .image-container:hover img {
    transform: scale(1.02);
  }
</style>
